# Environment for the laya model service (alternate backend).
#
# laya has no official image; run it from Python, e.g.:
#   pip install "laya[serve]" && laya-serve --host 0.0.0.0 --port 8000
# then point archivist at it with ARCHIVIST_MODEL=laya and
# ARCHIVIST_MODEL_URL=http://<host>:8000.

# Model cache location (persist on a volume to skip re-downloads).
HF_HOME=/weights

# Compute device laya selects:
#   auto (default) — cuda | mps | xpu | cpu, in that preference order
#   cuda | mps | xpu | cpu
LAYA_DEVICE=auto

# Server bind.
LAYA_HOST=0.0.0.0
LAYA_PORT=8000
