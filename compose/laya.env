# Environment for the laya model service (built from Dockerfile.laya).
#
# Use with:
#   docker compose -f docker-compose.yml -f docker-compose.laya.yml up --build

# Model weight cache (mounted as a named volume). HF_HOME is the standard
# Hugging Face cache location; laya uses it via the HF hub.
HF_HOME=/weights/hub

# Compute device:
#   auto (default) — cuda > mps > xpu > cpu, in that preference order
#   cuda | mps | xpu | cpu
LAYA_DEVICE=auto

# Default model checkpoint:
#   multilingual (default here) — handles documents in any language
#   english                     — faster, English-only documents
#   typed-decisions             — specialised for structured decision tasks
LAYA_DEFAULT_MODEL=multilingual

# Preload checkpoints at startup to avoid cold-start latency on first request.
#   1 (default) — load at startup
#   0           — load lazily on first request
LAYA_PRELOAD=1

# Server bind.
LAYA_HOST=0.0.0.0
LAYA_PORT=8000

# Optional: Hugging Face token for private models or higher rate limits.
# HF_TOKEN=

# Optional: bearer token to protect the laya endpoint.
# LAYA_API_KEY=
