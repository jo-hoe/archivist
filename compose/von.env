# Environment for the von model service.
#
# HF_HOME points model downloads at the mounted weights volume so they persist
# across restarts (and are skipped when already present).
HF_HOME=/weights

# Compute device the von server selects:
#   auto (default) — CUDA if available, else OpenVINO/CPU
#   cuda | cpu | openvino
# The GPU override (docker-compose.gpu.yml) sets this to `cuda`.
VON_DEVICE=auto

# Server bind.
VON_HOST=0.0.0.0
VON_PORT=8000
