# Environment for the von model service.
#
# HF_HOME points model downloads at the mounted weights volume so they persist
# across restarts (and are skipped when already present).
HF_HOME=/weights

# Compute device. Von auto-selects the best available accelerator in this order:
#   OpenVINO CPU > plain CPU > CUDA > MPS > OpenVINO GPU
#
# Override with one of: cuda | mps | openvino:gpu | openvino:cpu | cpu
# The published :cpu image uses OpenVINO and supports CPU and Intel GPU out of
# the box. For CUDA/ROCm you must build the image locally from the von source
# with --build-arg TORCH_BACKEND=default (not distributed due to wheel size).
VON_DEVICE=auto

# Server bind.
VON_HOST=0.0.0.0
VON_PORT=8000
