# Build laya directly from its GitHub source with the CPU torch index.
# Switch TORCH_INDEX to cu130 (and LAYA_DEVICE to cuda) for NVIDIA GPU.
FROM python:3.11-slim AS base

ARG TORCH_INDEX=cpu
ARG TORCH_VERSION=2.14.0

# Install laya with its HTTP server extras, using the requested torch build.
RUN pip install --no-cache-dir \
    "torch==${TORCH_VERSION}" --index-url "https://download.pytorch.org/whl/${TORCH_INDEX}" \
    "laya[serve]"

# Run as a non-root user (matches the convention of the official laya image).
RUN useradd -u 1001 -r -s /bin/false laya
USER 1001

ENV LAYA_HOST=0.0.0.0 \
    LAYA_PORT=8000 \
    LAYA_DEVICE=auto \
    LAYA_PRELOAD=1 \
    LAYA_DEFAULT_MODEL=multilingual \
    HF_HOME=/home/laya/.cache/huggingface

EXPOSE 8000
CMD ["laya-serve"]
